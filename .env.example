# Gemini — required for live photo analysis. Demo encounters work without it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Photon Spectrum — optional. The web iMessage surface is the fallback.
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
SPECTRUM_WEBHOOK_SECRET=
WILDSIGNAL_TEXT_NUMBER=+16287895362
WILDSIGNAL_PHOTON_USER_ID=

# FalkorDB — optional. Without it, WildSignal keeps the same graph in memory.
FALKORDB_HOST=
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
